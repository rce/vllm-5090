# NVIDIA Nemotron 3.5 Lightning — MoE, 30B total / 3B active, Mamba hybrid
# (NemotronHForCausalLM), NVIDIA ModelOpt NVFP4. Text-only, no vision tower.
#
# Flags combine the vLLM recipe's base command with its verified rtx_pro_6000
# override — same sm120 architecture as the 5090, more VRAM — from
# https://recipes.vllm.ai/nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4.json
# There is no rtx_5090 profile upstream, so this is the closest verified set
# rather than a measured one. Two deliberate departures from it:
#   * --linear-backend marlin dropped. vLLM refuses FP8 Marlin on this GPU
#     ("please set VLLM_TEST_FORCE_FP8_MARLIN=1") and auto-selection picks the
#     native NVFP4 path, which is what the Qwen NVFP4 profiles use anyway.
#   * --mamba-cache-mode none kept from the sm120 override, not the generic
#     command's align.
#   * The recipe's "fast SSM cache" feature is only half usable here. Its
#     stochastic rounding emits a PTX .rs instruction that does not exist on
#     sm_120a ("Feature '.rs' not supported on .target 'sm_120a'") and aborts
#     codegen, so --enable-mamba-cache-stochastic-rounding and
#     --mamba-cache-philox-rounds are dropped. The fp16 SSM cache itself is
#     kept. That feature appears to assume datacenter Blackwell.
#
# MAX_MODEL_LEN and MAX_NUM_SEQS deliberately match the Qwen3.6-35B-A3B profile
# so the sweeps compare directly. Native context is actually 1,048,576.
MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
SERVED_MODEL_NAME=Nemotron-3.5-Lightning-30B-A3B
MAX_MODEL_LEN=65536
MAX_NUM_SEQS=32
GPU_MEMORY_UTILIZATION=0.8
KV_CACHE_DTYPE=fp8
REASONING_PARSER=nemotron_v3
TOOL_CALL_PARSER=qwen3_xml
ENFORCE_EAGER=0
LANGUAGE_MODEL_ONLY=0
SPEC_DECODE=0
SPEC_CONFIG={"method":"mtp","num_speculative_tokens":3}
VLLM_HAS_FLASHINFER_CUBIN=1
EXTRA_ARGS=--quantization modelopt_fp4 --attention-backend FLASHINFER --attention-config {"use_trtllm_attention":true} --enable-flashinfer-autotune --mamba-cache-mode none --async-scheduling --enable-chunked-prefill --mamba-ssm-cache-dtype float16
