# Qwen3.6-35B-A3B — MoE, 35B total / 3B active (256 experts, 8 routed + 1
# shared), NVIDIA ModelOpt NVFP4 checkpoint.
#
# The flag set below is the vLLM recipe's verified rtx_5090 profile, taken from
# variants.nvfp4.hardware_overrides.rtx_5090 in
# https://recipes.vllm.ai/Qwen/Qwen3.6-35B-A3B.json -- not hand-tuned.
# FlashInfer's TRT-LLM attention kernels are what require --block-size 128 and
# VLLM_HAS_FLASHINFER_CUBIN=1; 32 GB is what caps context at 64K.
MODEL=nvidia/Qwen3.6-35B-A3B-NVFP4
SERVED_MODEL_NAME=Qwen3.6-35B-A3B
MAX_MODEL_LEN=65536
# Deliberately 32, not the recipe's 8. Measured on this card: +54% throughput
# with a quarter of the tail latency on short prompts, and no penalty at 16K
# prompts (that workload is prefill-bound, so the slot count barely matters).
# See agent-notes/2026-09-06-concurrency-baseline.md.
MAX_NUM_SEQS=32
GPU_MEMORY_UTILIZATION=0.85
KV_CACHE_DTYPE=fp8
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_xml
# Only 3B parameters are active per token, so graphs fit here.
ENFORCE_EAGER=0
LANGUAGE_MODEL_ONLY=0
SPEC_DECODE=0
SPEC_CONFIG={"method":"mtp","num_speculative_tokens":4,"moe_backend":"flashinfer_cutlass"}
VLLM_HAS_FLASHINFER_CUBIN=1
EXTRA_ARGS=--quantization modelopt_fp4 --block-size 128 --moe-backend marlin --attention-backend flashinfer --attention-config {"use_trtllm_attention":true} --max-num-batched-tokens 8192 --enable-chunked-prefill --enable-prefix-caching --async-scheduling --skip-mm-profiling
