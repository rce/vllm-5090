# Qwen3.8-27B — dense 27B hybrid-attention VLM, NVFP4.
# Measured on one RTX 5090: 60,681 KV tokens at 32K, vision on, ~25 tok/s.
MODEL=Inferact/Qwen3.8-27B-NVFP4
SERVED_MODEL_NAME=Qwen3.8-27B
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=8
GPU_MEMORY_UTILIZATION=0.92
KV_CACHE_DTYPE=fp8
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder
# Weights fill the card; CUDA graph capture will not fit alongside them.
ENFORCE_EAGER=1
LANGUAGE_MODEL_ONLY=0
# Needs LANGUAGE_MODEL_ONLY=1 to fit — see README.
SPEC_DECODE=0
SPEC_CONFIG={"method":"mtp","num_speculative_tokens":3}
EXTRA_ARGS=
